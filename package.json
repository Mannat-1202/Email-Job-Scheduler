{
  "name": "reachinbox-scheduler-root",
  "version": "1.0.0",
  "private": true,
  "description": "Production-grade distributed email scheduler with BullMQ, Redis, PostgreSQL, Elasticsearch, and Next.js dashboard",
  "scripts": {
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build:backend": "npm --prefix backend run build",
    "build:frontend": "npm --prefix frontend run build",
    "start:backend": "npm --prefix backend start",
    "start:frontend": "npm --prefix frontend start",
    "prisma:generate": "npm --prefix backend run prisma:generate",
    "prisma:migrate": "npm --prefix backend run prisma:migrate",
    "test:burst": "npm --prefix backend run test:burst",
    "test:restart": "npm --prefix backend run test:restart"
  },
  "workspaces": [
    "backend",
    "frontend"
  ],
  "engines": {
    "node": ">=20.0.0"
  }
}
