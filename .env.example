# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/reachinbox_scheduler?schema=public"

# Redis (BullMQ queue and rate-limit counters)
REDIS_URL="redis://localhost:6379"

# Elasticsearch (Full-text email search mirror)
ELASTICSEARCH_URL="http://localhost:9200"

# Backend server configuration
PORT=5000
NODE_ENV=development

# BullMQ Worker configuration
WORKER_CONCURRENCY=5
MIN_DELAY_MS=2000

# Rate limiting limits
MAX_EMAILS_PER_HOUR=100
MAX_EMAILS_PER_HOUR_PER_SENDER=50

# Google OAuth (NextAuth frontend)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
NEXTAUTH_SECRET="reachinbox-scheduler-super-secret-jwt-key-2026"
NEXTAUTH_URL="http://localhost:3000"

# Slack OAuth v2
SLACK_CLIENT_ID=""
SLACK_CLIENT_SECRET=""
SLACK_REDIRECT_URI="http://localhost:5000/api/slack/oauth/callback"

# Optional fixed Ethereal credentials (if omitted, auto-provisioned per sender)
ETHEREAL_USER=""
ETHEREAL_PASS=""

# Frontend API connector
NEXT_PUBLIC_API_URL="http://localhost:5000"
